  },
  "content": {
    "type": "html",
    "$t": "<div style=\"text-align: center;\">\n<div style=\"text-align: center;\">\n<iframe allowfullscreen=\"\" frameborder=\"0\" height=\"315\" src=\"https://www.youtube.com/embed/ZMhstYpyUKI\" width=\"420\"></iframe></div>\n<br />2016.07／第268期<div style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; font-size: 12.0pt; mso-ansi-language: EN-US; mso-ascii-font-family: &quot;Taigi Unicode&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;; mso-bidi-language: AR-SA; mso-fareast-language: ZH-TW;\"><br /></span></div>\n<div style=\"text-align: left;\">\n<b><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; font-size: 16.0pt; mso-ansi-language: EN-US; mso-ascii-font-family: &quot;Taigi Unicode&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;; mso-bidi-font-size: 12.0pt; mso-bidi-language: AR-SA; mso-fareast-language: ZH-TW;\">▍問&nbsp;</span></b></div>\n<div style=\"text-align: left;\">\n<span style=\"font-family: 微軟正黑體, sans-serif; font-size: 12pt;\"><br /></span></div>\n<div style=\"text-align: left;\">\n<span style=\"font-family: 微軟正黑體, sans-serif; font-size: 12pt;\">作者：李淑貞</span></div>\n<div style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; font-size: 12.0pt; mso-ansi-language: EN-US; mso-ascii-font-family: &quot;Taigi Unicode&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;; mso-bidi-language: AR-SA; mso-fareast-language: ZH-TW;\"><br /></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\">Ing</span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">暗</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\">tsit</span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">條路特別長</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">我</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\">tī</span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">溪岸邊</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">只有長長</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\">ê</span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">身影</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">水流聲</span><span style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"> </span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">陪我行</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">倒影</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\">ê</span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">燈光</span><span style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"> </span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">照水路</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">水</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\">~~</span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">啊</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\">Beh</span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">去佗位</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">性命</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\">kám</span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">有期限</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">也是用淡薄仔</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\">ê</span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">氣（</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\">khuì</span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">）絲</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">闊</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\">bóng-bóng<o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">無地址門牌號</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"> <o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">致使有路無厝</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">放你</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\">sì-kè</span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">飄流</span><span style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"> <span lang=\"EN-US\"><o:p></o:p></span></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">佗位</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\">tsiah</span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">是永遠</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\">ê</span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">厝</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">想著人</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">性命有長有短</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">身苦病疼</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\">ê</span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">時</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\">tsūn<o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">救護車</span><span style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"> </span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">大聲</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\">hū-hū</span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">叫</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">停</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\">tī</span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">急診室門口</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">醫護人員搶救患者</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">病症無仝</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">輕症門診注射觀察</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">重症送入手術室開刀</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">生死天註定</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">最後</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">關</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\">tī</span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">加護病房內</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">四肢</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\">tī\nliú-liú </span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">靠儀器維持性命</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">病房外</span><span style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"> </span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">憂愁</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\">ê</span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">家屬</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">出入生死門</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">等</span><span style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"> </span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">等</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"> koh</span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">再等</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">心情沉重</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">暝</span><span style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"> </span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">雨冷</span><span style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"> </span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">風冷</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"><o:p></o:p></span></div>\n<div class=\"MsoNormal\" style=\"text-align: left;\">\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; mso-ascii-font-family: &quot;Taigi Unicode&quot;;\">合手問天</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; mso-fareast-font-family: 微軟正黑體;\"> <o:p></o:p></span></div>\n<div style=\"text-align: left;\">\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; font-size: 12.0pt; mso-ansi-language: EN-US; mso-ascii-font-family: &quot;Taigi Unicode&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;; mso-bidi-language: AR-SA; mso-fareast-language: ZH-TW;\">夢</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; font-size: 12.0pt; mso-ansi-language: EN-US; mso-bidi-font-family: &quot;Times New Roman&quot;; mso-bidi-language: AR-SA; mso-fareast-font-family: 微軟正黑體; mso-fareast-language: ZH-TW;\">tang</span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; font-size: 12.0pt; mso-ansi-language: EN-US; mso-ascii-font-family: &quot;Taigi Unicode&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;; mso-bidi-language: AR-SA; mso-fareast-language: ZH-TW;\">時</span><span lang=\"EN-US\" style=\"font-family: &quot;Taigi Unicode&quot;; font-size: 12.0pt; mso-ansi-language: EN-US; mso-bidi-font-family: &quot;Times New Roman&quot;; mso-bidi-language: AR-SA; mso-fareast-font-family: 微軟正黑體; mso-fareast-language: ZH-TW;\">tsiah ē</span><span style=\"font-family: &quot;微軟正黑體&quot;,&quot;sans-serif&quot;; font-size: 12.0pt; mso-ansi-language: EN-US; mso-ascii-font-family: &quot;Taigi Unicode&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;; mso-bidi-language: AR-SA; mso-fareast-language: ZH-TW;\">醒</span></div>\n</div>\n"
