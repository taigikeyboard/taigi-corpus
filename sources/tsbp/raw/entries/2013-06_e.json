  "title": {
    "type": "text",
    "$t": "愛情ê回聲"
  },
  "content": {
    "type": "html",
    "$t": "<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"line-height: 1.15; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">林昀樺</span></span></div>\n<b style=\"font-weight: normal;\"><span style=\"font-family: Times, Times New Roman, serif;\"><br /><span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"></span></span></b>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">耳空ê回聲</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">有一屑仔ê熟sāi</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">是回憶來kā我創治</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">Iah是你就tī tsia</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">越頭</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">心親像hō͘啥mi̍h壓迫</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">原來是</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">滿滿ê無重量ê回憶</span></span></div>\n<span style=\"font-family: Times, Times New Roman, serif;\"><b style=\"font-weight: normal;\"></b></span><br />\n<a name='more'></a><span style=\"font-family: Times, Times New Roman, serif;\"><span style=\"line-height: 1.15; white-space: pre-wrap;\"><br /></span></span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">愛情ê回聲</span><br />\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">聽著內心bat有ê pho̍k-pho̍k跳</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">聽著bat有ê堅持</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">聽著bat有ê誓盟</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">聽著我講過</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">Hō͘我一紀年</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">我也是無法度kā你bē記--得</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">思念、收藏、回聲</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">回聲kā我問</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">眷戀啥mi̍h？</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">後悔啥mi̍h？</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">不管是啥mi̍h</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">我知影</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">無法度越頭轉（tńg）--去</span></span></div>\n<b style=\"font-weight: normal;\"><span style=\"font-family: Times, Times New Roman, serif;\"><br /><span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"></span></span></b>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">愛情ê回聲</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">Koh一擺感受家己ê艱苦</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">知影hō͘你騙</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">也選擇原諒</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">Koh一擺感受家己ê gōng呆</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">啥mi̍h lóng是一場空</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">Lán感受ê快樂是實在--ê</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">Lán鬥陣ê回憶是有影--ê<span class=\"Apple-tab-span\" style=\"white-space: pre;\"> </span></span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">只是你是一個過路人</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">無屬tī我ê過路人</span></span></div>\n<b style=\"font-weight: normal;\"><span style=\"font-family: Times, Times New Roman, serif;\"><br /><span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"></span></span></b>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">愛情ê回聲</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">快樂</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">Hán-huah</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">艱苦</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">失神</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">……</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">每擺ê回聲</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">Lóng有伊ê意義</span></span></div>\n<b style=\"font-weight: normal;\"><span style=\"font-family: Times, Times New Roman, serif;\"><br /><span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"></span></span></b>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">愛情ê回聲</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">細膩去聽</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">Tsiah發現</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">Tsia-ê連疊（liân-tha̍h）ê聲</span></span></div>\n<div dir=\"ltr\" style=\"line-height: 1.15; margin-bottom: 0pt; margin-top: 0pt;\">\n<span style=\"background-color: transparent; color: black; font-style: normal; font-variant: normal; font-weight: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-family: Times, Times New Roman, serif;\">是上kài suí ê 聲音</span></span></div>\n<span style=\"font-family: Times, Times New Roman, serif;\"><br /><span style=\"vertical-align: baseline; white-space: pre-wrap;\"></span></span><span style=\"font-family: Arial; font-size: 15px; vertical-align: baseline; white-space: pre-wrap;\"></span><br /><span style=\"font-family: Arial; font-size: 15px; vertical-align: baseline; white-space: pre-wrap;\"></span>"
  },
