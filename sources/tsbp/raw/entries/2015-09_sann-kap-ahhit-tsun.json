vepErS1A8cxH01mVy4EOgZjhjBy2dA61NSRRBwHwt5F9JDes7fhacz80ZonfetGbE_leY\" style=\"margin-left: 1em; margin-right: 1em;\"></a><a href=\"https://blogger.googleusercontent.com/img/a/AVvXsEieV2QIhXr9HHUR2HOtdzdhOQ2Wp1m7IHy3uBv_evHn-w78CA6wDiws38-liC5BykMyHCPCY7FuvfwNGVZN0qZUrV06rcYXQCo8AgEOxqtCi1UPY0IE6rAPjQ7grG0y8AihZpPSGTUOGuYTqtTGtvTliSg-KRj7--sY_p-UB-agQcxVCQGI03C_GC5nDQ2r\" style=\"margin-left: 1em; margin-right: 1em;\"><img data-original-height=\"3035\" data-original-width=\"2150\" height=\"640\" src=\"https://blogger.googleusercontent.com/img/a/AVvXsEieV2QIhXr9HHUR2HOtdzdhOQ2Wp1m7IHy3uBv_evHn-w78CA6wDiws38-liC5BykMyHCPCY7FuvfwNGVZN0qZUrV06rcYXQCo8AgEOxqtCi1UPY0IE6rAPjQ7grG0y8AihZpPSGTUOGuYTqtTGtvTliSg-KRj7--sY_p-UB-agQcxVCQGI03C_GC5nDQ2r=w453-h640\" width=\"453\" /></a></div><img data-original-height=\"3035\" data-original-width=\"2150\" height=\"640\" src=\"https://blogger.googleusercontent.com/img/a/AVvXsEidaQaXaDkpMpCjsilyTc6lX2fgE564f2AYIvAVf00qSwiEo3yAxiDB86jVXjBxd_ilHhP3heSR8raU6j7dvQMWES1wShj1AlZzIVuxdFB5LJR2R-PjNaGEADnvepErS1A8cxH01mVy4EOgZjhjBy2dA61NSRRBwHwt5F9JDes7fhacz80ZonfetGbE_leY=w453-h640\" width=\"453\" /></div></div><div class=\"separator\" style=\"clear: both; text-align: center;\"><a href=\"https://blogger.googleusercontent.com/img/a/AVvXsEjGtsHgEXMt4lf0aebRi7Miat7G46G5JD_qDepdf8rPrKceB8RLeCjPvS_slArFU3YzLn-L9ucUOr_9IqyaxA8vu2Iew98-B6-_cfjVq5vukGQN9wFmQ0ZdSppBIuBxUHtK__Jj4etMkIIgcNh-hagyzYxJs07cVboFIc_Ruz9Qt7aAsuYLjxyOnAqcg_0u\" style=\"margin-left: 1em; margin-right: 1em;\"><br /></a></div><div class=\"separator\" style=\"clear: both; text-align: center;\"><div class=\"separator\" style=\"clear: both; text-align: center;\"><a href=\"https://blogger.googleusercontent.com/img/a/AVvXsEhphRKkl12fA41BFxjo2Ij-O8FKG0YxJDZkQf-L7CnrRmcDT8j5EARJyUVWYubJif6jUw4BC8fk5d0n-1kKdIymJ9iXtqWbCl1XPMa1yTW3XbMo8qjw7fbJXRtYdxpVrg0J31PeEaymZXxMUJ1kmJXpgU_e-tuAce29YGE6QVkFMNYAjCfSwatJWoRaxV6_\" style=\"margin-left: 1em; margin-right: 1em;\"></a><div class=\"separator\" style=\"clear: both; text-align: center;\"><a href=\"https://blogger.googleusercontent.com/img/a/AVvXsEhphRKkl12fA41BFxjo2Ij-O8FKG0YxJDZkQf-L7CnrRmcDT8j5EARJyUVWYubJif6jUw4BC8fk5d0n-1kKdIymJ9iXtqWbCl1XPMa1yTW3XbMo8qjw7fbJXRtYdxpVrg0J31PeEaymZXxMUJ1kmJXpgU_e-tuAce29YGE6QVkFMNYAjCfSwatJWoRaxV6_\" style=\"margin-left: 1em; margin-right: 1em;\"></a><a href=\"https://blogger.googleusercontent.com/img/a/AVvXsEhW_S1sfekWG9xHDgl6cOrusx2WNJoYJeyAMTA9fkzrsv4jNhOts_3lQqrOVLnpGO0v-KN0AU1lpiLpIh45MdYxXxYaJe7xmHatxy01Pq2UbqFEG5SycE03_tQQBTCVhoARzhZ6vd_1tQHWzYMP10kwg9nSWwx_hYCLpovB5JDrtW60CzBQtYxp_eqOPuQM\" style=\"margin-left: 1em; margin-right: 1em;\"><img data-original-height=\"3035\" data-original-width=\"2150\" height=\"640\" src=\"https://blogger.googleusercontent.com/img/a/AVvXsEhW_S1sfekWG9xHDgl6cOrusx2WNJoYJeyAMTA9fkzrsv4jNhOts_3lQqrOVLnpGO0v-KN0AU1lpiLpIh45MdYxXxYaJe7xmHatxy01Pq2UbqFEG5SycE03_tQQBTCVhoARzhZ6vd_1tQHWzYMP10kwg9nSWwx_hYCLpovB5JDrtW60CzBQtYxp_eqOPuQM=w453-h640\" width=\"453\" /></a></div><br /></div><div class=\"separator\" style=\"clear: both; text-align: left;\"><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">人講：「春天後母面，beh變一時間。」昨暝雷公雨tshia桶倒，到早起就好天--ah，tsit-tsūn日頭花出kah滿滿是，天氣一下燒lō，人mā ke偌有精神--leh。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">離開明翰文化ê第九個月，我又koh tńg--來--ah。為著翰翔集團beh kah阮出版社合作一套100本ê旅遊冊《台灣好tshit-thô》，hit爿總編輯指名ài我tńg來做。為著楊總--ê ê hit句話：「Tuì佗跋倒，就tuì佗peh--起-來。」為著儉錢tńg學校讀研究所，mā為著tài念經理in進前對我ê疼惜……</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">「筱雅，歡迎你tńg--來！我就知lán ê緣份無tsiah淺，是公司ê人hōo你走bē去……se̍h一輾你iáu是倒tńg來阮身邊。」開會ê時，楊總--ê&nbsp;án-ne講，hōo我感覺tsiok溫暖。經理一下看著我，隨hām我攬做伙講：「Tńg--來就好！以後lán koh ē-sái做伙拍拚……」</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">我tsit-má已經搬出hit間bē輸粉鳥櫥ê編輯室，楊總--ê講我家己負責一套冊mi̍h件khah濟，特別安排我坐經理對面hit个「大位」，頭前有經理thìng好參詳，後面是排版區隨時ē-tàng使用印表機hām影印機，koh有小秦--ā tsit个美術編輯thang tàu-sann-kāng。雖然我ê冊是直接送去吳副總ê華藝製版公司排版，m̄-koh hia-ê相片kah圖片tio̍h-ài iang小秦--ā tàu掃描。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">編輯室內底，桂英、秋雯hām如萍是老同事，以早阮bat同齊做囡仔冊《小朋友看台灣》。我離開了後，楊總--ê揣伊ê高中同學余俊麟來上班。小秦--ā mā是尾--à tsiah來--ê，伊本名號做秦大爺，上gâu激五仁古，逐工痟話講規擔，夭壽害！佳哉m̄是伊替我排版，若無，我早慢ē hōo惱--死。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">Tsit套《台灣好tshit-thô》是透過攝影師ê鏡頭、地圖ê指示hām我ê文字紹介，beh tshuā讀者tsiūnn山落海來去台灣sì-kè pha-pha走。創刊號是《蘭嶼風情》hām《台南古城》，一下發表就造成轟動，因為我ê寫法khah特別，hōo逐家看了suah ē tiâu底。親像寫蘭嶼，我將家己化身做一个tuì台灣嫁去蘭嶼ê查某人，hōo伊帶領讀者去看當地ê軍艦岩、情人洞等景點，koh再參加Tao（『達悟』）族ê大船落水、飛魚祭……。寫台南ê時，我用tsiânn深ê感情，因為阿風老師是台南人，冊內我幻想有一日hām家己kah意ê人tńg去伊ê故鄉，伊tshuā我去看赤崁樓、se̍h安平古堡、遊孔子廟、挽鳳凰花……。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">Tsit幾工經理接電話接kah手骨痠，因為有真濟讀者tsiok tshenn-huan，kan-na khà來beh揣嫁去蘭嶼ê編輯，若無，就是beh邀請我有去台南ài揣in出來lim咖啡，koh有人寄一寡仔a-lí-put-ta̍t ê mi̍h件來公司beh hōo--我，比論講卡片、相片、批信、護身符……經理一律將tsia-ê小禮物送hōo pùn-sò車。吳副總笑我講：「筱雅，你tsit回sńg siunn大--ah。Koh有98本，看你beh佗生出hiah濟故事？」我kā應講：「Tse你就免煩惱！日頭下跤，逐工mā ē有新齣頭。」</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">尾--à我寫tńg故鄉北海岸看阿媽、hām阿爸去金門遊戰地、tuè hip相老師去台東hip炮炸寒單爺、kah朋友做伙peh南湖大山……逐本lóng有新花樣，m̄-nā翰翔文化ê總編輯tsiânn欣賞，行銷人員mā有話題thang去推銷，讀者tiānn-tiānn khà電話來參經理開講。有時我感覺家己有淡薄仔衝，有時感覺hia-ê人真囉嗦，看冊就看冊，a̍h tio̍h tsiah-nī厚sua-sap？佳哉公司ài我保持神祕，只要負責寫稿、做冊，賰--ê lóng免我操煩，我tsiah敢穩心仔發揮。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">平常時早起逐家lóng ài hām楊總--ê開會，參詳每日ê khang-khuè內容。In做囡仔冊ê人khah濟、ài去會議室，便講lò-lò長一、兩點鐘走bē去。若我tsiah閒仙仙，攝影師是專家，我寫文章mā tsiânn老練，只要去hām in討論每一个單元beh按怎安排、相片揀好，我tńg來寫故事；落尾tsiah提去華藝製版hia排版、校對，等拍樣煞就ē-sái看藍圖，最後是送入去印刷。楊總--</span><span style=\"font-family: arial; font-size: large;\">ê</span><span style=\"font-family: arial; font-size: large;\">&nbsp;lóng免啥操心，所以我慣勢透早入去總經理室向伊報告今仔日ê行程——大部份是kā講我tī時beh去佗一位老師hia揀相片，iah是去吳副總hia看樣稿，連中晝hām朋友約食飯mā tio̍h交代，若無，伊一下揣無人，手機仔khà kah kiōng-beh燒--去！經理講伊tsit步siunn bái才，聽講是因為楊總--</span><span style=\"font-family: arial; font-size: large;\">ê</span><span style=\"font-family: arial; font-size: large;\">以前無閒拚事業，疏忽著家庭，落尾伊ê前某suah來tuè人走，舞kah弄家散宅，tsit-má tsiah ē tsiah-nī無安全感。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">逐擺in規陣人若踮會議室盤喙錦，經理hām我就tī外口ná作穡ná話仙，講kah真歡喜。有一改，經理講著細漢ê時hōo in老爸吊起來拍，講kah目屎流目屎滴。我mā想起古早阮阿爸上儉電koh上tsheh查某囡仔讀冊，逐暗我tī客廳看書，一下聽著阿爸peh起來beh放尿，隨禁火走tńg去房間假睏；等伊入去睏，我tsiah-koh起來用功。有一暗我走了siunn雄，跤鼻liâm suah去kha̍p著鞋櫥仔門，真疼！M̄-koh我驚人罵，緊走去眠床倒hōo好勢；等阿爸入去伊房間，我tsiah摸著跤骨tâm-tâm，一下kā看māi，血水淹淹流……。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">「筱雅，無要緊！In ē老，lán ē大……」經理提衛生紙hōo我拭目屎。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">楊總--ê一下出--來，看著阮兩个mà-mà-háu tshuah一tiô，叫是發生啥mih代誌。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">後--來阮beh講傷心代，盡量揀下晡時楊總--ê去翰翔文化揣王董--ê泡茶hit-tsūn。若無，伊ē罵阮食飽siunn閒，講講hia-ê五四三，無彩tsiah濟目屎。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">無法度！人講：「查某人是水做--ê。」講著傷心事ē哭，想起美好ê代誌mā ē流目屎。親像經理講著伊15歲hit時老母死，hōo阿兄hòo出門，ē哭；大腹肚beh生營--ā ê時，hōo伊前翁tsàm kah大出血，ē哭；想起in阿媽hām老母對伊ê疼惜，仝款哭kah ē失聲去……阮ê個性lóng tsiânn硬，若是拄著工作上ê困難絕對bē目屎滴，因為阮知影目屎bē-tàng解決問題，阮ê目屎kan-na留hōo hia-ê所恨--過kah所愛--過ê人。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">經理總算出頭天--ah。離婚了後，將營--ā留hōo伊ê前翁是伊上艱苦ê代誌，因為hit个那敬忠根本就是一个pùn-sò人，除了tshit-thô、phānn tshit仔啥mi̍h to m̄ tshap，營--ā lóng是in前ta-ke hām前小姑那竹欣leh管顧。Tsit-má經理嫁hōo楊總--ê，腹肚內koh有家己ê囡仔，hōo伊感覺日子愈來愈好過，對未來mā愈來愈有ǹg望……</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">真欣羨經理ē-sái揣著幸福，我mā beh一步一步行向家己ê夢想，去到心中上suí ê hit个所在。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">※　※　※</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">頂晡，經理kah我去新店山區拜訪一位原住民攝影師坤--哥。因為交通無方便，koh是頭一改接觸，伊bē放心就揹一khian肚駛車載我去。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">阮去坤--哥hia想beh了解原住民ê飲食文化，一下去到tè伊tsiok熱情phâng出三杯「kan-na hōo家己人lim ê飲料」，一人一杯，一直招呼阮試看kám有kah喙。經理tng-leh喙ta，一大喙kā lim--落，喙--裡是tsiânn呵咾，m̄-koh表情有淡薄仔無自然。我tsi̍p--一-下，心內huah講：「夭壽，酸kah kánn-ná狗母尿--leh！」</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">坤--哥ná介紹ná叫阮「免客氣！」，硬叫阮ke lim--一-寡，講tse別位保證lim bē著，伊是看人tsiah beh pun人鼻芳--ê……我實在無才調拒絕koh tsi̍p兩、三下，假仙一直寫字，記錄伊所講ê內容。經理無代誌thang做，姑不而將細細喙沓沓仔lim，一睏仔坤--哥 隨koh kā阮ê杯仔斟hōo tīnn，就án-ne sian lim mā lim bē了……。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">採訪煞，我感覺一粒頭殼lin-long-se̍h，tsiok愛睏，m̄-koh我m̄敢tī車底睏，想講經理腹肚hiah-nī大koh駛車驚ē危險，就一直kah伊開講。到公司門口，經理叫我家己tńg公司，伊ê頭tsiok gông--ah，beh先tńg去睏一醒tsiah來。佳哉in兜就tī公司邊--a niā-niā，伊驚楊總--ê煩惱，叫我講伊去美容院做頭鬃。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">我一下轉到辦公室，將楊總--ê規鈷茶米茶灌了了，隨phak tī桌頂siàng大眠。睏kah下晡2點外，tsiah起來揣mi̍h食孝孤兼作穡。楊總--ê看我採訪稿tàn tī桌頂，伊有閒先提去看，但是按怎to看lóng無，走來問--我：「筱雅，你寫tse啥mih死骨頭？」</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">「實在講我mā看m̄ bat！後日仔tsiah講，我緊來khà電話問經理 “頭鬃” 創好--未？」Tsit个楊總--ê有時仔tsiânn囉嗦，我khah要緊經理kám gông煞--ah，m̄知ài去hōo醫生看--無？</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">「無，你兩个是偷偷仔走去lim燒酒--ooh？」聽小秦--ā tī hia làu-ē-hâi，是m̄是燒酒我m̄知，m̄-koh頭眩目暗真正tsiok艱苦。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">經理一直到4點外來公司，tsiah kā楊總--ê講阮兩个去採訪ê過程。小秦--ā一直講佳哉經理kah我做伙去，若無，我可能就醉死tī hia--ah。伊講話本底就有khah hàm古，愈講愈m̄是款，講啥mih hit个坤--哥一定是對我有企圖，想beh kā我灌醉tsiah-koh kā我按怎。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">「Án-ne生坤--哥tsit本lán mài做！攝影師koh揣就有，無差伊一个，iáu未簽約lán無差。」</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">Tsit个小秦--ā真是厚話，人坤--哥正經是好意招待--阮，只是飲食習慣無仝niā-niā，suah hōo伊講kah tsiah歹聽。楊總--ê&nbsp;mā真害，經理hām我講--ê m̄相信，顛倒去信hit个一支喙糊luì-luì ê khong人。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">暗時6點外，逐家lóng無閒kah iáu未走，經理講伊beh tshuā營--ā去學泅水，先去灶跤煮兩碗泡麵，一碗hōo楊總--ê，一碗phâng來叫我趁燒食，食完thang好去華藝看樣稿。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">我食kah一半想講外口to無落雨，按怎一直聽著si-si-su̍t-su̍t ê聲？一下越頭看，原來是坐我後面tng-leh tuè小秦--ā排版ê桂英哭kah兩蕊目睭紅kì-kì，拄好提衛生紙leh tshìng鼻。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">「桂英，你按怎？哪ē哭kah tsiah傷心？」</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">「平平是人，哪ē大細漢差tsiah濟？你beh加班就有暗頓thang食，阮逐个做kah死mā無人tshap！」伊ná哭ná講，ná講koh ná哭。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">我……ē-tàng講啥mi̍h？只好緊食食--leh來溜suan。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">「筱雅，吳副總翁仔某暗時無tī hia，若做siunn暗tsiah叫黃經理載你去市政府坐車……」出門進前，楊總--ê&nbsp;kā我交代。真正hōo伊害--死！Án-ne生桂英in kan-na ē koh-khah倒tuānn niā-niā，kám是tshûn-pān beh hōo我歹做人？</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">華藝ê頭家是吳副總，頭家娘逐家lóng叫伊「黃姊」，黃經理是黃姊ê小弟，in人tsiânn古意，tsuan kài好鬥陣。Tsit久吳副總mā有投資阮明翰文化，算--起-來逐家坐仝一隻船，家己人tàu sio-thīn是應該--ê。吳副總翁仔某知影我參楊總--ê、阮經理ê情份無仝，加上進前tī公司ê表現，in早就kā我惜入心。見若我過去排版，m̄-nā有燒茶lim，有四秀仔食，做khah暗定著有人ē載我去捷運站，逐項代誌lóng替我安排kah好勢好勢。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">吳副總上kah意ê員工是阿洲，因為伊hām我是仝一間大學畢業--ê，我就叫伊「學長」，伊mā正經kā我當做家己ê學妹看待。可能是年紀差不多，阮兩人tsiok有話講。我上愛伊替我排版，因為伊kài有耐性，無論我偌nī龜毛、偌nī狡怪，伊絕對ē做kah hōo我無話講。參伊做伙作穡，hōo我感覺tsiânn放心。阮公司以早hit个助理依婷sù常leh講：「阿洲逐項lóng好，可惜無夠lò跤！」凊彩--lah！做khang-khuè ē頂真上要緊，tse hām身kuân無關係。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">「筱雅，你tńg--來mā已經--一-站-仔，對進前白老師hit件代誌kám有啥mih發現？」吳副總問--我。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">「煞煞--去，我無想hiah濟，kan-na想beh kā tsit套冊做hōo好……」</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">「Lín楊總--ê、柳經理kám lóng無beh調查hōo清楚？」</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">「In知我hām hit三sian婆姐bē ha̍h，mài做仝一套冊就好，逐家 “田無交，水無流”。」</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">「你家己ài khah斟酌--leh，tsit套《台灣好tshit-thô》賣kah siah-siah叫，m̄知啥人又koh目空赤，……人tī暗，你tī明，張持無si̍h本！」黃姊叮嚀--我。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">我知in翁仔某是好意提醒--我，m̄-koh有一寡人、一寡代誌是無法度提防，拄--著kan-na ē-sái算家己khah衰niâ，無影無跡、無證無據，又koh ē-tàng按怎？</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">「我看hit三sian婆姐，穆桂英上歹liú-lia̍h，kha̍p-bē著請出伊ê爸母，別人是 “一人當選，三人服務”，伊是 “一个上班，三个做事”，莫怪lín楊總--ê&nbsp;m̄甘將伊辭掉！」</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">吳副總本tsiânn無kah意桂英，因為伊蹛tī公司附近，爸母tsuan孝飽閒閒，伊一通電話隨khà隨到：m̄管是做司機接送、做雜差仔買mi̍h件iah是kuānn便當，有時mā ē iang in駛車去提圖稿、走郵局……in兩翁仔某kan-na生tsit个寶貝查某囝，只要查某囝歡喜，叫in做牛做馬也甘願。就án-ne熟sāi桂英ê人，百面ē bat伊tsit對惜查某囝ê爸母，mā ē受著in爸母ê看顧。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">「秋雯家己一人ài趁錢飼囝，壓力khah大；如萍無半撇，莫怪逐項to聽桂英--ê。Lín楊總--ê&nbsp;mā m̄知leh pìnn啥mih báng？用一个完全bē-hiáu ê如萍準拄煞，koh tshiànn hit尾余大哥實在有夠大尾，早時peh bē起--來，睏kah下晡tsiah來上班。那竹欣hit尊菩薩koh-khah心適，領錢beh--lah，入辦公室伊bē giàn！」吳副總ná排版ná se̍h-se̍h唸。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">「人余大哥是楊總--ê&nbsp;ê高中同學，那竹欣是柳經理ê前小姑，你kā人管hiah濟！」黃姊罵--伊。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">「知--lah！M̄是講筱雅生做tsiok成伊ê查某囝？我看tsit箍楊總--ê凊彩講講--leh，若正經in查某囝去hōo人陷害，看伊kám真正ē激恬恬！」</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\">吳副總huan咐--我：「若koh拄著進前hit款àu屎步，ē記得一通電話我隨趕到位，阮華藝thīn你到底！」Koh交代阿洲ài khah tsia̍p去明翰看--我，m̄-thang hōo人叫是我無靠山。</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: medium;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: x-small;\">(後期繼續)</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial; font-size: x-small;\"><br /></span></div><div class=\"separator\" style=\"clear: both;\"><div><h2 style=\"text-align: center;\"><div style=\"font-size: medium; font-weight: 400; text-align: left;\"><span style=\"font-family: arial; font-size: medium;\"><div class=\"separator\" style=\"clear: both; text-align: center;\"><a href=\"https://blogger.googleusercontent.com/img/a/AVvXsEj0oJzAm_wPgax06L5TdsRISbqscrm5YgIMSKIzZFDX_KKU1o4yvN3EIogzXvZWae7WSzEx4_yLfoOAOyV1Lek6fjIsMsGtF9Nw9xoH3_voCphga2FJM5BGRuBa3fGvqjA7zU8HqZs2bzsWvgap1HBAZdgS4wCGubSx4ZJ9fXP24kbzGBIQiSuLhiI8eSb-\" style=\"margin-left: 1em; margin-right: 1em;\"><img data-original-height=\"3035\" data-original-width=\"2150\" height=\"640\" src=\"https://blogger.googleusercontent.com/img/a/AVvXsEj0oJzAm_wPgax06L5TdsRISbqscrm5YgIMSKIzZFDX_KKU1o4yvN3EIogzXvZWae7WSzEx4_yLfoOAOyV1Lek6fjIsMsGtF9Nw9xoH3_voCphga2FJM5BGRuBa3fGvqjA7zU8HqZs2bzsW