    "$t": "錯誤ê選擇"
  },
  "content": {
    "type": "html",
    "$t": "<span id=\"internal-source-marker_0.5873241585213691\" style=\"font-family: Times, Times New Roman, serif;\"><br />李淑貞<br /><b style=\"font-weight: normal;\"><span style=\"font-size: 15px; vertical-align: baseline; white-space: pre-wrap;\"></span></b><br /><span style=\"font-size: 15px; font-weight: bold; vertical-align: baseline; white-space: pre-wrap;\">滿腹ê委屈</span><br /><span style=\"font-size: 15px; font-weight: bold; vertical-align: baseline; white-space: pre-wrap;\">你</span><br /><span style=\"font-size: 15px; font-weight: bold; vertical-align: baseline; white-space: pre-wrap;\">當做無看--見</span><br /><span style=\"font-size: 15px; font-weight: bold; vertical-align: baseline; white-space: pre-wrap;\">只好</span><br /><span style=\"font-size: 15px; font-weight: bold; vertical-align: baseline; white-space: pre-wrap;\">囥tī目睭內底</span><br /><span style=\"font-size: 15px; font-weight: bold; vertical-align: baseline; white-space: pre-wrap;\">忍受</span><br /><span style=\"font-size: 15px; font-weight: bold; vertical-align: baseline; white-space: pre-wrap;\"></span></span><br />\n<a name='more'></a><span style=\"font-family: Times, Times New Roman, serif;\">想著hit段</span><br />\n<span style=\"font-family: Times, Times New Roman, serif; font-size: 15px; font-weight: bold; vertical-align: baseline; white-space: pre-wrap;\">甜蜜ê心跳ê聲音</span><br />\n<span style=\"font-family: Times, Times New Roman, serif; font-size: 15px; font-weight: bold; vertical-align: baseline; white-space: pre-wrap;\">感情變卦</span><br />\n<span style=\"font-family: Times, Times New Roman, serif; font-size: 15px; font-weight: bold; vertical-align: baseline; white-space: pre-wrap;\">揣無溫暖ê靠岸</span><br />\n<span style=\"font-family: Times, Times New Roman, serif; font-size: 15px; font-weight: bold; vertical-align: baseline; white-space: pre-wrap;\">啥mih時tsūn ē回頭</span><br />\n<span style=\"font-family: Times, Times New Roman, serif; font-size: 15px; font-weight: bold; vertical-align: baseline; white-space: pre-wrap;\">Kâⁿ講</span><br />\n<span style=\"font-family: Times, Times New Roman, serif; font-size: 15px; font-weight: bold; vertical-align: baseline; white-space: pre-wrap;\">你bē做斷線ê風吹</span><br />\n<span style=\"font-family: Times, Times New Roman, serif; font-size: 15px; font-weight: bold; vertical-align: baseline; white-space: pre-wrap;\">Tī天頂sì-kè飛</span><br />\n<span style=\"font-family: Times, Times New Roman, serif; font-size: 15px; font-weight: bold; vertical-align: baseline; white-space: pre-wrap;\">Tiāⁿ-tiāⁿ pang</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\"><b style=\"font-weight: normal;\"><span style=\"font-size: 15px; vertical-align: baseline; white-space: pre-wrap;\"></span></b><br /></span>\n<span style=\"font-family: Times, Times New Roman, serif; font-size: 15px; font-weight: bold; vertical-align: baseline; white-space: pre-wrap;\">目屎</span><br />\n<span style=\"font-family: Times, Times New Roman, serif; font-size: 15px; font-weight: bold; vertical-align: baseline; white-space: pre-wrap;\">吞bē落ê</span><br />\n<span style=\"font-family: Times, Times New Roman, serif; font-size: 15px; font-weight: bold; vertical-align: baseline; white-space: pre-wrap;\">無奈ê吐khuì</span><br />\n<span style=\"font-family: Times, Times New Roman, serif; font-size: 15px; font-weight: bold; vertical-align: baseline; white-space: pre-wrap;\">心肝親像</span><br />\n<span style=\"font-family: Times, Times New Roman, serif; font-size: 15px; font-weight: bold; vertical-align: baseline; white-space: pre-wrap;\">烏陰天氣</span><br />\n<span style=\"font-family: Times, Times New Roman, serif; font-size: 15px; font-weight: bold; vertical-align: baseline; white-space: pre-wrap;\">雨sap-sap </span><br />\n<b id=\"internal-source-marker_0.6814482035115361\" style=\"font-weight: normal;\"><span style=\"font-family: 'Times New Roman'; font-size: 16px; vertical-align: baseline; white-space: pre-wrap;\">tī天頂四界飛</span></b>"
  },
