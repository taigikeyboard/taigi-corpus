pan face=\"arial, helvetica, sans-serif\" style=\"font-size: medium;\"><b><a href=\"https://tsbp.tgb.org.tw/2015/07/327-e.html\" target=\"_blank\">編輯室ê話</a></b></span></div><br /></div><div align=\"center\"><br /></div><div align=\"center\"><br /><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"MsoNormalTable\" style=\"border-collapse: collapse; mso-padding-alt: 0cm 0cm 0cm 0cm; mso-table-layout-alt: fixed;\">\n <tbody><tr style=\"height: 13pt; mso-height-rule: exactly; mso-yfti-firstrow: yes; mso-yfti-irow: 0;\">\n  <td colspan=\"3\" style=\"background: rgb(220, 220, 221); height: 13pt; mso-height-rule: exactly; mso-pattern: solid #DCDCDD; mso-shading: windowtext; padding: 1.4pt; width: 296.95pt;\" width=\"396\">\n  <p align=\"left\" class=\"a0\" style=\"line-height: normal;\"><span style=\"font-family: inherit;\"><span class=\"a1\"><b><span style=\"color: #656464;\">做伙來唸詩</span></b></span><o:p></o:p></span></p>\n  </td>\n </tr>\n <tr style=\"height: 13pt; mso-height-rule: exactly; mso-yfti-irow: 1;\">\n  <td style=\"height: 13pt; mso-height-rule: exactly; padding: 1.4pt; width: 110.9pt;\" width=\"148\">\n  <p class=\"a0\" style=\"layout-grid-mode: char; line-height: normal;\"><span style=\"font-family: inherit;\"><span class=\"a1\">林榮淑</span><o:p></o:p></span></p>\n  </td>\n  <td style=\"height: 13pt; mso-height-rule: exactly; padding: 1.4pt; width: 6cm;\" width=\"227\">\n  <p class=\"a0\" style=\"layout-grid-mode: char; line-height: normal;\"><span style=\"font-family: inherit;\"><a href=\"https://tsbp.tgb.org.tw/2015/07/e_1.html\" target=\"_blank\"><span class=\"a1\">美麗</span><span class=\"a1\">ê</span><span class=\"a1\">島嶼</span></a><o:p></o:p></span></p>\n  </td>\n  <td style=\"height: 13pt; mso-height-rule: exactly; padding: 1.4pt; width: 15.95pt;\" width=\"21\">\n  <p align=\"right\" class=\"a0\" style=\"layout-grid-mode: char; line-height: normal; text-align: right;\"><span style=\"font-family: inherit;\"><span class=\"a2\">1</span><o:p></o:p