  "title": {
    "type": "text",
    "$t": "烏面lā-pue"
  },
  "content": {
    "type": "html",
    "$t": "<span style=\"font-family: Times, Times New Roman, serif;\">郭文卿</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\"><br /></span>\n<span style=\"font-family: Times, Times New Roman, serif;\">飛啊飛 飛啊飛 飛過高山kap平地</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">飛啊飛 飛啊飛 飛過大海kap大溪</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">身軀白白烏喙pue 目睭金金頭犁犁</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">喙pue扁扁跤短短 妝kah suí-suí掠魚蝦</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">Lā-pue啊lā-pue 歡迎來到曾文溪</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">Lā-pue啊lā-pue 七股溪邊來奉茶</span><br />\n<br />\n<a name='more'></a><span style=\"font-family: Times, Times New Roman, serif;\"><br /></span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">飛啊飛 飛啊飛 飛過天清烏暗地</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">飛啊飛 飛啊飛 飛過透風落雨暝</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">千辛萬苦來做伙 飛來飛去千萬回</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">Lín是guán ê好人客 永遠永遠ê寶貝</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">Lā-pue啊lā-pue &nbsp;飛來故鄉幸福地</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">Lā-pue啊lā-pue &nbsp;Guán ē用心來交陪</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\"><br /></span>\n<span style=\"font-family: Times, Times New Roman, serif;\">飛啊飛 飛啊飛 飛過天光換明月</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">飛啊飛 飛啊飛 飛過日夜teh輪迴</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">來來去去無反悔 歇睏趁食無問題</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">M̄免驚惶孤一个 M̄免煩惱無人陪</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">Lā-pue啊lā-pue 自由自在sì-kuè飛</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">Lā-pue啊lā-pue 七股溪邊再相會</span><br />\n<br />"
  },
