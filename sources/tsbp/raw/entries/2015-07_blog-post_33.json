  "title": {
    "type": "text",
    "$t": "稻仔弄花"
  },
  "content": {
    "type": "html",
    "$t": "<p><span style=\"font-size: large;\"><b>作者：</b></span><span style=\"font-size: large;\"><b>陳錦月</b></span></p><div><div class=\"separator\" style=\"clear: both; text-align: center;\"><br /></div></div><p style=\"text-align: justify;\"><span style=\"font-size: large;\">稻仔弄花</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">蝶仔iānn-iānn飛</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">稻草人</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">一領破衫風雨吹</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">顧暝徛日啥人替</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">溫柔月娘來sio陪</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">Thìng候</span></p><blockquote style=\"border: none; margin: 0 0 0 40px; padding: 0px;\"><p style=\"text-align: justify;\"><span style=\"font-size: large;\">稻穗飽漿頭lê-lê</span></p></blockquote><p style=\"text-align: justify;\"><span style=\"font-size: large;\">風調雨順</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">Thang好</span></p><blockquote style=\"border: none; margin: 0 0 0 40px; padding: 0px;\"><p style=\"text-align: justify;\"><span style=\"font-size: large;\">褪換舊衫穿新鞋</span></p></blockquote><p style=\"text-align: justify;\"><span style=\"font-size: large;\"><br /></span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">稻仔弄花</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">塗粉iānn-iānn飛</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">厝鳥仔</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">Khoo伴討食leh走揣</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">電火索頂講情話</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">斜西日鬚tshiō紅霞</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">Thìng候</span></p><blockquote style=\"border: none; margin: 0 0 0 40px; padding: 0px;\"><p style=\"text-align: justify;\"><span style=\"font-size: large;\">稻穗飽漿頭lê-lê</span></p></blockquote><p style=\"text-align: justify;\"><span style=\"font-size: large;\">腹肚款飽</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">Thang好</span></p><blockquote style=\"border: none; margin: 0 0 0 40px; padding: 0px;\"><p style=\"text-align: justify;\"><span style=\"font-size: large;\">sio-tshuā歇siū睏樹ue</span></p></blockquote><p style=\"text-align: justify;\"><span style=\"font-size: large;\"><br /></span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">稻仔弄花</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">日鬚iānn-iānn飛</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">作穡人</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">手攑鋤頭liâu過溪</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">頭毛喙鬚已經白</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">Hòo水巡田啥人替</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">Thìng候</span></p><blockquote style=\"border: none; margin: 0 0 0 40px; padding: 0px;\"><p style=\"text-align: justify;\"><span style=\"font-size: large;\">稻穗飽漿頭lê-lê</span></p></blockquote><p style=\"text-align: justify;\"><span style=\"font-size: large;\">五穀豐收</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">Thang好</span></p><blockquote style=\"border: none; margin: 0 0 0 40px; padding: 0px;\"><p style=\"text-align: justify;\"><span style=\"font-size: large;\">泡茶lo̍k-tô講笑詼</span></p></blockquote><p style=\"text-align: justify;\"><br /></p><div class=\"separator\" style=\"clear: both; text-align: center;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEi3XSCP_7Ey-qPW8hSY84IB9pYBtxWsZjU2d-5mFoEl0Ua-iKGhVEm-ciEzYOjiPkfompc5DsJmA7Nu3Ge8m