    "$t": "<p>&nbsp;</p><h1 style=\"text-align: center;\"><span style=\"font-size: x-large;\">《</span><span style=\"font-size: x-large;\">Tshui-sak台語，</span><span style=\"font-size: x-large;\">導師來tàu tshuā》</span><span style=\"font-size: large;\">/</span><span style=\"text-align: left;\"><span style=\"font-size: medium;\">廖啟助</span></span></h1><div><span><div class=\"separator\" style=\"clear: both; font-size: xx-large; text-align: center;\"><a href=\"https://blogger.googleusercontent.com/img/a/AVvXsEhFlmwPL0K9n19aN9h_bHH4zuupohtpl7sIgfGDpBSeN_xnaU4KXgN11uMkIklo1OD1VqOQEUcC8MI3G8m2TUuowavxhVS4aL7SH3ccv928qYvdtahRDE5MsNb4nWMY5A6WjWQYy07ttTmMXzVRlTR73T2SonIlzPrnMngP4pa8F9XOU-iBBIruWRjOxkWD\" style=\"margin-left: 1em; margin-right: 1em;\"></a><div class=\"separator\" style=\"clear: both;\"><a href=\"https://blogger.googleusercontent.com/img/a/AVvXsEhFlmwPL0K9n19aN9h_bHH4zuupohtpl7sIgfGDpBSeN_xnaU4KXgN11uMkIklo1OD1VqOQEUcC8MI3G8m2TUuowavxhVS4aL7SH3ccv928qYvdtahRDE5MsNb4nWMY5A6WjWQYy07ttTmMXzVRlTR73T2SonIlzPrnMngP4pa8F9XOU-iBBIruWRjOxkWD\" style=\"margin-left: 1em; margin-right: 1em;\"></a><a href=\"https://blogger.googleusercontent.com/img/a/AVvXsEiEsLw6ZCFg8bChQjPuJjX5qRNWZkfg_wvT_ZKiZnRLqn7w62pLYaRZb3IDvs91DwMN4LMK0zM5_MFc807zLnGuek1OQNUkY6fv1GMaLi1kvjXk0ehAEmThXwM67TZJHDtQABVjuiOoh00XIIwd6TGcw_by1mf1jktLUgHoIAjRDQgYmGcwpNgs8JC1bpey\" style=\"margin-left: 1em; margin-right: 1em;\"></a><div class=\"separator\" style=\"clear: both;\"><a href=\"https://blogger.googleusercontent.com/img/a/AVvXsEiEsLw6ZCFg8bChQjPuJjX5qRNWZkfg_wvT_ZKiZnRLqn7w62pLYaRZb3IDvs91DwMN4LMK0zM5_MFc807zLnGuek1OQNUkY6fv1GMaLi1kvjXk0ehAEmThXwM67TZJHDtQABVjuiOoh00XIIwd6TGcw_by1mf1jktLUgHoIAjRDQgYmGcwpNgs8JC1bpey\" style=\"margin-left: 1em; margin-right: 1em;\"></a><a href=\"https://blogger.googleusercontent.com/img/a/AVvXsEi2dE5zb7-w1PTQrNUXICsJgbuf8pmiiS2IzOrb3UbeUfMWdbH9e1Udh8xgYWzCh2xiGmrFhxpp_37YVyo7htOrAXcpoRcmGWEjWdBd_oXql7N61FTzXVCVjJMRQcJ4zMUa1vwYFM88YIR4VOB1Qat2jXZy4q0IdLwsTYvRiEchQU-Zk8DiQGyQ