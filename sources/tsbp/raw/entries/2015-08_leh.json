  },
  "content": {
    "type": "html",
    "$t": "<p><span style=\"font-size: large;\"><span><b>作者：</b></span></span><span style=\"font-size: large;\"><b>蔡婕馨</b></span></p><div><div class=\"separator\" style=\"clear: both; text-align: center;\"><br /></div></div><p style=\"text-align: justify;\"><span style=\"font-size: large;\">有--ah</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">恭喜--ooh</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">噓　慢且</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">三個月後tsiah thang講</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\"><br /></span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">Tio̍h--ah</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">細膩--ooh</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">Hooh　趕緊</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">自我隔離mài接觸</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\"><br /></span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">平平兩條線</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">心態天差地--leh</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">驗著有身huah恭喜</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">驗著確診身體虛</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\"><br /></span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">平平兩條線</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">小心照護顧身命</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">有身等食雞酒</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">確診等解隔離</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\"><br /></span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">人生難免有意外</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">意外ê驚喜</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">意外ê確診</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">天差地--leh ê兩條線</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">Lóng ài有ǹg望</span></p><p style=\"text-align: justify;\"><br /></p><div style=\"text-align: justify;\"><br /></div><div style=\"text-align: justify;\"><br /></div><span><a name='more'></a></span><div class=\"separator\" style=\"clear: both; text-align: center;\"><br /></div><div class=\"separator\" style=\"clear: both; text-align: center;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjFW17bAwX3morSiFl-2Ko67Y_iKFynIPIb0IMCTkbQ_6qtotb7p3gDr5iZU_z5zescjp_6o-RE5GiqUtG1_QVnS3VgBtQFLjbgi3nq76JUAYpigiKBJf4h0bjKvAM0Klw5dvhppeSzVc_glONfk3vRi0L6hiPSrpIYV3BW5o0SuHowZqLcTKpe0XJnuFqV/s3036/%E5%8F%B0%E6%96%87%E9%80%9A%E8%A8%8ABONG%E5%A0%B1353%E6%9C%9F_03_1.jpg\" imageanchor=\"1\" style=\"margin-left: 1em; margin-right: 1em;\"><img border=\"0\" data-original-height=\"3036\" data-original-width=\"2150\" height=\"640\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjFW17bAwX3morSiFl-2Ko67Y_iKFynIPIb0IMCTkbQ_6qtotb7p3gDr5iZU_z5zescjp_6o-RE5GiqUtG1_QVnS3VgBtQFLjbgi3nq76JUAYpigiKBJf4h0bjKvAM0Klw5dvhppeSzVc_glONfk3vRi0L6hiPSrpIYV3BW5o0SuHowZqLcTKpe0XJnuFqV/w454-h640/%E5%8F%B0%E6%96%87%E9%80%9A%E8%A8%8ABONG%E5%A0%B1353%E6%9C%9F_03_1.jpg\" width=\"454\" /></a></div><br /><div class=\"separator\" style=\"clear: both; text-align: center;\"><br /></div><br /><div class=\"separator\" style=\"clear: both; text-align: center;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEite1hQ49Ng2M8LKboG32zd0sqsYxFCdyPxGCJ8npeWLzC8R8bJ6ptQU-iWK6C9qZhfMjCsB30eBwmbahF6lsyXlbvbEGfXFpT1E4_lG2ecRGGcg1-boZ4L5Lmgwt7WYIqfFPR_XCoGREByMQvRE2Uer2i5sq7eOK9TIDACWVjjxOZonMYAemGxV-f5U_1W/s1424/353%E5%8F