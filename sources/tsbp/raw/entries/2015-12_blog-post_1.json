    "$t": "鹿角龜"
  },
  "content": {
    "type": "html",
    "$t": "<p><span style=\"font-size: large;\"><span><b>作者：</b></span></span><span style=\"font-size: large;\"><b>洪振民&nbsp;</b></span></p><div><div class=\"separator\" style=\"clear: both; text-align: center;\"><br /></div></div><p style=\"text-align: justify;\"><span style=\"font-size: large;\">5--月嚴重ê疫情</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">停課校園真恬靜</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">白雞油花味芳清</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">Siânn來蟲thuā樹身停</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">身穿鐵甲ti̋ng-tīng-tīng</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">樹身咬出thuah鍊形</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">母--ê suh汁喙瀾津</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">公--ê thn̂g種意志堅</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">鹿角帽戴戰甲兵</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">Bē輸奧運ê菁英</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">Ián落樹跤心tsiânn凝</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">自然生態suí情景</span></p><div style=\"text-align: justify;\"><br /></div><div style=\"text-align: justify;\"><br /></div><span><a name='more'></a></span><div style=\"text-align: justify;\"><br /></div><p></p><div class=\"separator\" style=\"clear: both; text-align: center;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjrldw8BuR87slPkQdfZoyGM9ehTQNQ7DhT5TWcTX2qc1X8mSbYvcg6ta1RgFQXqL9fcpHSt9ugTxZUKAo4nZPVMyDU2-WDMR_lBk1WlrZ96SjSlgVYC0_RltR6sD0DChXqgc2yjohFnjspg_H6_A3Tdbrl5Ry066HfZkDbB4l91b-SlLTb-dPctseBhg/s1424/344%E5%8F%B0%E6%96%87%E9%80%9A%E8%A8%8ABONG%E5%A0%B1_%E5%B0%81%E9%9D%A2.jpg\" style=\"margin-left: 1em; margin-right: 1em;\"><img border=\"0\" data-original-height=\"1424\" dat