    "$t": "體會"
  },
  "content": {
    "type": "html",
    "$t": "<p><span style=\"font-size: large;\"><span><b>作者：</b></span></span><span style=\"font-size: large;\"><b>孫翊倫</b></span></p><div><div class=\"separator\" style=\"clear: both; text-align: center;\"><br /></div></div><p style=\"text-align: justify;\"><span style=\"font-size: large;\">酥芳ê皮</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">咬落飽tīnn ê菜蔬</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">Kah濟濟肉</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\"><br /></span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">內底té tsiok濟</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">無底深坑</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">揣無ê問題</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\"><br /></span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">人生無難題</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">Kan-na看你kám想beh</span></p><blockquote style=\"border: none; margin: 0px 0px 0px 40px; padding: 0px;\"><p style=\"text-align: justify;\"><span style=\"font-size: large;\">無遺憾buē撤退</span></p></blockquote><p style=\"text-align: justify;\"><span style=\"font-size: large;\">勇敢行到底</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\"><br /></span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">食老tsiah體會</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">人生17就出嫁</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">一生趁家伙</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">到tann 50外歲</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">M̄ bat享受過</span></p><blockquote style=\"border: none; margin: 0px 0px 0px 40px; padding: 0px;\"><p style=\"text-align: justify;\"><span style=\"font-size: large;\">一頓好料--ê</span></p></blockquote><p style=\"text-align: justify;\"><span style=\"font-size: large;\">Lóng mā先留hōo序細</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">家己食上尾--ê</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">無人beh--ê</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\"><br /></span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">減肥代免koh sueh</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">Khah食mā無幾歲</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">喙iáu-koh tín動--leh</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">目睭iáu-koh tńg--leh</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">Sì-kè tshit-thô烏白se̍h</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">Sì-kè食si̍t sì-kè買</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">無遺憾直透到尾</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\"><br /></span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">人生</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">Lán lóng leh</span></p><blockquote style=\"border: none; margin: 0px 0px 0px 40px; padding: 0px;\"><p style=\"text-align: justify;\"><span style=\"font-size: large;\">揣上suí ê地</span></p></blockquote><p style=\"text-align: justify;\"><span style=\"font-size: large;\">M̄-koh</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">Lán mā ē</span></p><blockquote style=\"border: none; margin: 0px 0px 0px 40px; padding: 0px;\"><p style=\"text-align: justify;\"><span style=\"font-size: large;\">hōo地變美麗</span></p></blockquote><div style=\"text-align: justify;\"><br /></div><div style=\"text-align: justify;\"><br /></div><span><a name='more'></a></span><div class=\"separator\" style=\"clear: both; text-align: center;\"><br /><br /></div><div class=\"separator\" style=\"clear: both; text-align: center;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEg5bY-wWvMHjjk0tUid2wHWOj0CJrLwvmUVn_BzyDM83hA_sCzk3GgX-pfD1915iCKqZxl7V6AQJ8jFcUQgAixHy4ZPQVcmIqgxHOZwT5zYX3dnKWUa-uUcodcFx37f0n7eY1-ocFFK2A5akSjxtTpO8Z9l_vQ2H5knTeUa7mv4I5HjoSf4lBQSYmebGA/s1421/345%E5%8F%B0%E6%96%87%E9%80%9A%E8%A8%8ABONG%E5%A0%B1_%E5%B0%81%E9%9D%A2.jpg\" style=\"margin-left: 1em; margin-right: 1em;\"><img border=\"0\" data-original-height=\"1421\" data-original-width=\"1000\" height=\"640\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEg5bY-wWvMHjjk0tUid2wHWOj0CJrLwvmUVn_BzyDM83hA_sCzk3GgX-pfD1915iCKqZxl7V6AQJ8jFcUQgAixHy4ZPQVcmIqgxHOZwT5zYX3dnKWUa-uUcodcFx37f0n7eY1-ocFFK2A5akSjxtTpO8Z9l_vQ2H5knTeUa7mv4I5HjoSf4lBQSYmebGA/w450-h640/345%E5%8F%B0%E6%96%87%E9%80%9A%E8%A8%8ABONG%E5%A0%B1_%E5%B0%81%E9%9D%A2.jpg\" width=\"450\" /></a></div><br /><br /><div class=\"separator\" style=\"clear: both; text-align: center;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiMPD0zEREGAGvDp2aQojIgwTkowA0MYarA7XLMqnK7Pw1eOFl-Gpx0KoZai2fD1PAqRMT36haqYSDvs25OJtObjK1yAv4WpnwNuUnOm4xooLOubfeCLVd8eA-AWVVIISATUWviZZGvpYrPTwFZDc4PD0Y44xbvKcq0wtpP5YPLXidbzyz4X8rXRLGgow/s3036/%E5%8F%B0%E6%96%87%E9%80%9A%E8%A8%8ABONG%E5%A0%B1345%E6%9C%9F_%E9%BB%91%E7%99%BD%E5%85%A7%E9%A0%8148%E9%A0%814.jpg\" imageanchor=\"1\" style=\"margin-left: 1em; margin-right: 1em;\"><img border=\"0\" data-original-height=\"3036\" data-original-width=\"2150\" height=\"640\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiMPD0zEREGAGvDp2aQojIgwTkowA0MYarA7XLMqnK7Pw1eOFl-Gpx0KoZai2fD1PAqRMT36haqYSDvs25OJtObjK1yAv4WpnwNuUnOm4xooLOubfeCLVd8eA-AWVVIISATUWviZZGvpYrPTwFZDc4PD0Y44xbvKcq0wtpP5YPLXidbzyz4X8rXRLGgow/w454-h640/%E5%8F%B0%E6%96%87%E9%80%9A%E8%A8%8ABONG%E5%A0%B1345%E6%9C%9F_%E9%BB%91%E7%99%BD%E5%85%A7%E9%A0%8148%E9%A0%814.jpg\" width=\"454\" /></a></div><br /><div cla