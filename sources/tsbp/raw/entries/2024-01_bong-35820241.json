    "$t": "<div class=\"separator\" style=\"clear: both; text-align: center;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiyzZ0YOBQ9e2P1HsUp7oOsTqb7nBmzcWFIWM6VgHp0DZf5dFlsDgGExh2xl1XvU15djJe3GCxWs4MK_0UPEqJbzeqgHFqpGcN5Akk6theiJ3q-hthaJXfTYznb5fDKAEt7pwwBPMmh08AdNKaJ6guFBcqMiFX0QBZk1aPsxsmCQxJlbEyQbdhrVzgS0psX/s1424/358%E5%8F%B0%E6%96%87%E9%80%9A%E8%A8%8ABONG%E5%A0%B1_%E5%B0%81%E9%9D%A2.jpg\" style=\"margin-left: 1em; margin-right: 1em;\"><img border=\"0\" data-original-height=\"1424\" data-original-width=\"1000\" height=\"640\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiyzZ0YOBQ9e2P1HsUp7oOsTqb7nBmzcWFIWM6VgHp0DZf5dFlsDgGExh2xl1XvU15djJe3GCxWs4MK_0UPEqJbzeqgHFqpGcN5Akk6theiJ3q-hthaJXfTYznb5fDKAEt7pwwBPMmh08AdNKaJ6guFBcqMiFX0QBZk1aPsxsmCQxJlbEyQbdhrVzgS0psX/w450-h640/358%E5%8F%B0%E6%96%87%E9%80%9A%E8%A8%8ABONG%E5%A0%B1_%E5%B0%81%E9%9D%A2.jpg\" width=\"450\" /></a></div><br /><div class=\"separator\" style=\"clear: both; text-align: center;\"><br /></div><div class=\"separator\" style=\"clear: both; text-align: center;\"><h3 style=\"clear: both;\"><span style=\"font-family: inherit; font-size: large;\">封面作品</span></h3><h3 style=\"clear: both;\"><div><span style=\"font-size: large;\"><span style=\"font-weight: 400;\"><a href=\"https://tsbp.tgb.org.tw/2015/01/bong358-ka.html\" target=\"_blank\">Kā狗仔洗身軀</a></span></span></div><div><span style=\"font-size: large;\"><span style=\"font-weight: 400;\"><br /></span></span></div></h3><h3><span><span style=\"font-family: inherit; font-size: large;\"><a href=\"https://tsbp.tgb.org.tw/2015/01/bong358-e.html\" target=\"_blank\">編輯室ê話</a></span></span></h3><div><span><br /></span></div><h3><span><span style=\"font-family: inherit; font-size: large;\"><a href=\"https://tsbp.tgb.org.tw/2019/10/bong.html\" target=\"_blank\">徵稿啟事</a></span></span></h3><div><br /></div><div><h3><span style=\"font-size: large;\">做伙來唸詩</span></h3><div><div><span style=\"font-size: large;\">陳昭蓉<br /><a href=\"https://tsbp.tgb.org.tw/2015/02/blog-post_19.html\" target=\"_blank\">苳蒿</a></span></div><div><span style=\"font-size: large;\"><span style=\"white-space: normal;\">1<br /><br /></span></span></div><div><span style=\"font-size: large;\">郭文玄<br /><a href=\"https://tsbp.tgb.org.tw/2015/02/blog-post_59.html\" target=\"_blank\">不止是黃晴美，不止是台灣黃晴美</a></span></div><div><span style=\"font-size: large;\"><span style=\"white-space: normal;\">2<br /><br /></span></span></div><div><span style=\"font-size: large;\">陳&nbsp; &nbsp; 雷<br /><span style=\"white-space: pre;\"></span><a href=\"https://tsbp.tgb.org.tw/2015/02/chheng-sat.html\" target=\"_blank\">Chhèng-sat</a></span></div><div><span style=\"font-size: large;\"><a href=\"https://tsbp.tgb.org.tw/2015/02/chheng-sat.html\" target=\"_blank\">銃殺</a></span></div><div><span style=\"font-size: large;\"><span style=\"white-space: normal;\">39<br /><br /></span></span></div><div><span style=\"font-size: large;\">顏毓黛<br /><span style=\"white-space: pre;\"></span><a href=\"https://tsbp.tgb.org.tw/2015/02/blog-post_60.html\" target=\"_blank\">無仝</a><br /><span style=\"white-space: pre;\"></span>40<br /><br /></span></div><h3><span style=\"font-size: large;\">阿瑞--ā話仙</span></h3><div><span style=\"font-size: large;\">藍春瑞<br /><a href=\"https://tsbp.tgb.org.tw/2015/02/e_5.html\" target=\"_blank\">山路ê光景</a><br /><span style=\"white-space: pre;\"></span>6<br /><br /></span></div><h3><span style=\"font-size: large;\">演講稿</span></h3><div><span style=\"font-size: large;\">陳春美<br /><a href=\"https://tsbp.tgb.org.tw/2015/02/e-hiau.html\" target=\"_blank\">我若是ē-hiáu飛</a><br /><span style=\"white-space: pre;\"></span>8</span></div><div><span style=\"font-size: large;\"><br /></span></div><h3><span style=\"font-size: large;\">台語sa攏有講座</span></h3><div><span style=\"font-size: large;\">主講／洪明道</span></div><div><span style=\"font-size: large;\">記錄／吳玉祥<br /><span style=\"white-space: pre;\"></span><a href=\"https://tsbp.tgb.org.tw/2015/02/e_6.html\" target=\"_blank\">洗腰子ê歷史</a><br /><span style=\"white-space: pre;\"></span>10</span></div><div><span style=\"font-size: large;\"><br /></span></div><h3><span style=\"font-size: large;\">來唸七字仔</span></h3><div><span style=\"font-size: large;\">楊忠憲<br /><span style=\"white-space: pre;\"></span><a href=\"https://tsbp.tgb.org.tw/2015/02/blog-post_6.html\" target=\"_blank\">結婚講好話（一）</a></span></div><div><span style=\"font-size: large;\"><span style=\"white-space: normal;\">12</span></span></div><div><span style=\"font-size: large;\"><span style=\"white-space: normal;\"><br /></span></span></div><h3><span style=\"font-size: large;\">台灣人寫真</span></h3><div><span style=\"font-size: large;\">林長禧<br /><span style=\"white-space: pre;\"></span><a href=\"https://tsbp.tgb.org.tw/2015/02/e-tsit.html\" target=\"_blank\">種龍眼ê tsit陣人</a><br /><span style=\"white-space: pre;\"></span>13</span></div><div><span style=\"font-size: large;\"><br /></span></div><div><span style=\"font-size: large;\">巫素宜<br /><span style=\"white-space: pre;\"></span><a href=\"https://tsbp.tgb.org.tw/2015/02/ma-tioh-ai.html\" target=\"_blank\">俗衫mā tio̍h-ài俗錢</a><br /><span style=\"white-space: pre;\"></span>14</span></div><div><span style=\"font-size: large;\"><br /></span></div><div><span style=\"font-size: large;\">林采風<br /><span style=\"white-space: pre;\"></span><a href=\"https://tsbp.tgb.org.tw/2015/02/e_94.html\" target=\"_blank\">阿婆煮ê麵</a><br /><span style=\"white-space: pre;\"></span>16</span></div><div><span style=\"font-size: large;\"><br /></span></div><h3><span style=\"font-size: large;\">寶島好食mi̍h</span></h3><div><span style=\"font-size: large;\">吳睿穎<br /><span style=\"white-space: pre;\"></span><a href=\"https://tsbp.tgb.org.tw/2015/02/hit.html\" target=\"_blank\">Hit粒肉包</a><br /><span style=\"white-space: pre;\"></span>18</span></div><div><span style=\"font-size: large;\"><br /></span></div><div><span style=\"font-size: large;\">思&nbsp; &nbsp; 菊<br /><span style=\"white-space: pre;\"></span><a href=\"https://tsbp.tgb.org.tw/2015/02/e_17.html\" target=\"_blank\">寒--人半暝ê羊油米糕</a><br /><span style=\"white-space: pre;\"></span>19</span></div><div><span style=\"font-size: large;\"><br /></span></div><h3><span style=\"font-size: large;\">光景bóng uē</span></h3><div><span style=\"font-size: large;\">陳榮廷<br /><span style=\"white-space: pre;\"></span><a href=\"https://tsbp.tgb.org.tw/2015/02/e_29.html\" target=\"_blank\">三峽「大學花園城」ê松、竹、梅街</a><br /><span style=\"white-space: pre;\"></span>20<br /></span></div><div><span style=\"font-size: large;\"><br /></span></div><h3><span style=\"font-size: large;\">Sann-kap讀小說</span></h3><div><span style=\"font-size: large;\">黃靜惠<br /><span style=\"white-space: pre;\"></span><a href=\"https://tsbp.tgb.org.tw/2015/02/blog-post_86.html\" target=\"_blank\">講古傳情（一）</a><br /><span style=\"white-space: pre;\"></span>22</span></div><div><span style=\"font-size: large;\"><br /></span></div><h3><span style=\"font-size: large;\">Lán來講看māi</span></h3><div><span style=\"font-size: large;\">Tēnn Bûn-kî（鄭文琦）<br /><span style=\"white-space: pre;\"></span><a href=\"https://tsbp.tgb.org.tw/2015/02/tuie.html\" target=\"_blank\">Tuì台東傳到德國ê露螺食譜</a><br /><span style=\"white-space: pre;\"></span>26</span></div><div><span style=\"font-size: large;\"><br /></span></div><div><span style=\"font-size: large;\">陳育萱<br /><span style=\"white-space: pre;\"></span><a href=\"https://tsbp.tgb.org.tw/2015/01/te-siang.html\" target=\"_blank\">囡仔出世tè siáng姓？</a><br /><span style=\"white-space: pre;\"></span>28</span></div><div><span style=\"font-size: large;\"><br /></span></div><div><span style=\"font-size: large;\">陳火舌（Tân Hóe-chi̍h）<br /><span style=\"white-space: pre;\"></span><a href=\"https://tsbp.tgb.org.tw/2015/01/e_54.html\" target=\"_blank\">講我穿查某衫ê代誌</a><br /><span style=\"white-space: pre;\"></span>31</span></div><div><span style=\"font-size: large;\"><br /></span></div><div><span style=\"font-size: large;\">Tân Lō͘</span></div><div><span style=\"font-size: large;\"><a href=\"https://tsbp.tgb.org.tw/2015/02/khiang.html\" target=\"_blank\">Khiàng跤俠女黃晴美</a></span></div><div><span style=\"font-size: large;\"><a href=\"https://tsbp.tgb.org.tw/2015/02/khiang.html\" target=\"_blank\">——寫「四二四刺蔣」記念</a><br /><span style=\"white-space: pre;\"></span>33</span></div><div><span style=\"font-size: large;\"><br /></span></div><h3><span style=\"font-size: large;\">心內話</span></h3><div><span style=\"font-size: large;\">蕭平治<br /><span style=\"white-space: pre;\"></span><a href=\"https://tsbp.tgb.org.tw/2015/02/80.html\" target=\"_blank\">80歲生日感言——感恩人生</a><br /><span style=\"white-space: pre;\"></span>35</span></div><h3><span style=\"font-size: large;\"><br /></span><span style=\"font-size: large;\">逐家來phò-tāu</span></h3><div><span style=\"font-size: large;\"><i>Aminegy</i> Khó͘<span style=\"white-space: pre;\">\t</span><br /><a href=\"https://tsbp.tgb.org.tw/2015/02/siau-ang-phai-chiau-ko.html\" target=\"_blank\">Siáu Ang Pháiⁿ Chiàu-kò͘</a></span></div><div></div><div><span style=\"font-size: large;\"><a href=\"https://tsbp.tgb.org.tw/2015/02/siau-ang-phai-chiau-ko.html\" target=\"_blank\">痟翁歹照顧</a></span></div><div><span style=\"font-size: large;\"><span style=\"white-space: normal;\">42<br /></span></span></div></div></div><div><br /></div><br /></div><div><span><span><div style=\"text-align: center;\"><span><a name='more'></a></span><div class=\"separator\" style=\"clear: both; text-align: center;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhlGPvuSXXZ5xEtWRUHnuBOmqfAYHglrkFAMdVZQtH0G1yBxT_bup1pY2N4da5nrB-yAn-8seRtiPBWCXVBRMU7u9s3vMD5K2R8LNCeDWHXLttehL_lAqDXCifvom_oVRru4VoVWjPaztBYczC68zt4HonOOUwids4RItDUQ8xh3lnEozcR_iuMaGO7G9S0/s3036/%E5%8F%B0%E6%96%87%E9%80%9A%E8%A8%8ABONG%E5%A0%B1358%E6%9C%9F_.jpg\" style=\"margin-left: 1em; margin-right: 1em;\"><img border=\"0\" data-original-height=\"3036\" data-original-width=\"2150\" height=\"640\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXs