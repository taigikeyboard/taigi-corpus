    "type": "html",
    "$t": "<div class=\"separator\" style=\"clear: both; text-align: center;\">\n<a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjVxpLlRqUKeb1UspqUim84eefMSM2LTa3ZqZlGTxjGKibW6McGZH0hWGOtuI9qcN9OIbZWBOVdKGFaa79KJ9KhTVDYgGIiPDg6l6B_2iBLICOfw7qtI8HE7hbuFAfGvCyVPkPlcXXhb1d-/s1600/219.jpg\" style=\"margin-left: 1em; margin-right: 1em;\"><img border=\"0\" height=\"640\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjVxpLlRqUKeb1UspqUim84eefMSM2LTa3ZqZlGTxjGKibW6McGZH0hWGOtuI9qcN9OIbZWBOVdKGFaa79KJ9KhTVDYgGIiPDg6l6B_2iBLICOfw7qtI8HE7hbuFAfGvCyVPkPlcXXhb1d-/s1600/219.jpg\" width=\"482\" /></a></div>\n<br />\n\n\n<b><span face=\"華康粗圓體\"><span style=\"color: red;\">219期</span></span><span style=\"color: red;\">目</span><span lang=\"EN-US\" style=\"color: red;\">&nbsp;&nbsp;</span><span style=\"color: red;\">錄&nbsp;</span></b><br /><br /><div class=\"MsoNormal\"><b><span face=\"新細明體\" style=\"color: blue; font-size: 11pt;\">做伙來唸詩</span></b><b><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\"><o:p></o:p></span></b></div><div class=\"MsoNormal\"><b><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></b></div><div class=\"a\"><span face=\"文泉驿正黑\">台北米香</span><span face=\"新細明體\" lang=\"EN-US\">/</span><span face=\"文泉驿正黑\">鹿港海</span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\">洪錦田<span lang=\"EN-US\">/</span>大跤婆</span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\"><a href=\"http://tsbp.tgb.org.tw/2012/07/blog-post.html\" target=\"_blank\">吳正任<span lang=\"EN-US\">/</span>記持</a></span></div><div class=\"MsoNormal\"><b><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></b></div><div class=\"MsoNormal\"><b><span face=\"新細明體\" style=\"color: blue; font-size: 11pt;\">台文青年</span></b><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\"><o:p></o:p></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></div><div class=\"MsoNormal\"><a href=\"http://tsbp.tgb.org.tw/2012/07/blog-post_31.html\" target=\"_blank\"><span face=\"新細明體\" style=\"font-size: 11pt;\">吳竹鈺</span><span face=\"新細明體\" lang=\"EN-US\" style=\"font-size: 11pt;\">/</span><span face=\"新細明體\" style=\"font-size: 11pt;\">紅豆</span></a></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\">張琬如</span><span face=\"新細明體\" lang=\"EN-US\" style=\"font-size: 11pt;\">/</span><span face=\"新細明體\">養</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode';\">--ê</span><span face=\"新細明體\">恩情</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode';\">khah</span><span face=\"新細明體\">大天</span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\">王薈雯</span><span face=\"新細明體\" lang=\"EN-US\" style=\"font-size: 11pt;\">/</span><span face=\"新細明體\" style=\"font-size: 11pt;\">雅各</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode';\">ê</span><span face=\"新細明體\" style=\"font-size: 11pt;\">樓梯</span></div><div class=\"MsoNormal\"><b><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\"><br /></span></b></div><div class=\"MsoNormal\"><span style=\"color: blue;\"><b><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">Hakka</span></b><b><span face=\"新細明體\" style=\"font-size: 11pt;\">屋家</span></b></span><b><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\"><o:p></o:p></span></b></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\">吳瑞琪</span><span face=\"新細明體\" lang=\"EN-US\" style=\"font-size: 11pt;\">/</span><span face=\"新細明體\" style=\"font-size: 11pt;\">鷹揚</span></div><div class=\"MsoNormal\"><b><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></b></div><div class=\"MsoNormal\"><b><span face=\"新細明體\" style=\"color: blue; font-size: 11pt;\">台譯歌詩</span></b><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\"><o:p></o:p></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\">陳榮廷</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">/</span><span face=\"新細明體\" style=\"font-size: 11pt;\">相信</span></div><div class=\"MsoNormal\"><b><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></b></div><div class=\"MsoNormal\"><span style=\"color: blue;\"><b><span face=\"新細明體\" style=\"font-size: 11pt;\">基金會</span></b><b><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">15</span></b><b><span face=\"新細明體\" style=\"font-size: 11pt;\">周年</span></b></span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\"><o:p></o:p></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\">廖瑞銘</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">/</span><span face=\"新細明體\" style=\"font-size: 11pt;\">台文作家</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">kap&nbsp;</span><span face=\"新細明體\" style=\"font-size: 11pt;\">《台文通訊》</span></div><div class=\"MsoNormal\"><b><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></b></div><div class=\"MsoNormal\"><b><span face=\"新細明體\" style=\"color: blue; font-size: 11pt;\">台羅會交流道</span></b><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\"><o:p></o:p></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></div><div class=\"MsoNormal\"><a href=\"http://tsbp.tgb.org.tw/2012/07/kapm.html\" target=\"_blank\"><span face=\"新細明體\" style=\"font-size: 11pt;\">蔣為文</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">/</span><span class=\"commentbody\"><span face=\"新細明體\" style=\"font-size: 11pt;\">是「台語」</span></span><span class=\"commentbody\"><span lang=\"NL\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">kap</span></span><span class=\"commentbody\"><span face=\"新細明體\" style=\"font-size: 11pt;\">「咱人話」，</span><span style=\"font-size: 11pt;\"><span style=\"font-family: 'Taigi Unicode';\">m̄</span></span></span><span class=\"commentbody\"><span face=\"新細明體\" style=\"font-size: 11pt;\">是「閩南話」！</span></span></a></div><div class=\"MsoNormal\"><b><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></b></div><div class=\"MsoNormal\"><b><span face=\"新細明體\" style=\"color: blue; font-size: 11pt;\">花埕照日</span></b><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\"><o:p></o:p></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></div><div class=\"MsoNormal\"><a href=\"http://tsbp.tgb.org.tw/2012/07/kap.html\" target=\"_blank\"><span face=\"新細明體\" style=\"font-size: 11pt;\">王昭華</span><span face=\"新細明體\" lang=\"EN-US\" style=\"font-size: 11pt;\">/</span><span face=\"新細明體\" style=\"font-size: 11pt;\">草仔枝</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">kap</span><span face=\"新細明體\" style=\"font-size: 11pt;\">老雞母</span></a></div><div class=\"MsoNormal\"><b><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></b></div><div class=\"MsoNormal\"><span style=\"color: blue;\"><b><span face=\"新細明體\" style=\"font-size: 11pt;\">海口人講古</span></b><b><span lang=\"NL\" style=\"font-size: 11pt;\"><o:p></o:p></span></b></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\">蔡信得</span><span face=\"新細明體\" lang=\"EN-US\" style=\"font-size: 11pt;\">/</span><span face=\"新細明體\" style=\"font-size: 11pt;\">漁網</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">ê</span><span face=\"新細明體\" style=\"font-size: 11pt;\">由來</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">20<o:p></o:p></span></div><div class=\"MsoNormal\"><b><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></b></div><div class=\"MsoNormal\"><b><span face=\"新細明體\" style=\"color: blue; font-size: 11pt;\">台灣人寫真</span></b><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\"><o:p></o:p></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\">陳隆</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">/</span><span face=\"新細明體\" style=\"font-size: 11pt;\">陳錦芳</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">/</span><span face=\"新細明體\" style=\"font-size: 11pt;\">盧榮杰</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">/</span><span face=\"新細明體\" style=\"font-size: 11pt; letter-spacing: -0.5pt;\">世界台灣同鄉會聯合會</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt; letter-spacing: -0.5pt;\">&nbsp;(</span><span face=\"新細明體\" style=\"font-size: 11pt; letter-spacing: -0.5pt;\">世台會</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt; letter-spacing: -0.5pt;\">)&nbsp;</span><span face=\"新細明體\" style=\"font-size: 11pt; letter-spacing: -0.5pt;\">簡史</span><span face=\"新細明體\" style=\"font-size: 9pt; letter-spacing: -0.5pt;\">（五）</span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></div><div class=\"MsoNormal\"><a href=\"http://tsbp.tgb.org.tw/2012/07/blog-post_2094.html\" target=\"_blank\"><span face=\"新細明體\" style=\"font-size: 11pt;\">林美麗</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">/</span><span face=\"新細明體\" style=\"font-size: 11pt;\">宋米仔對抗大海翁</span></a></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\">藍春瑞</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">/</span><span face=\"新細明體\" style=\"font-size: 11pt;\">生理人心肝</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">kap</span><span face=\"新細明體\" style=\"font-size: 11pt;\">頭殼</span></div><div class=\"MsoNormal\"><b><span lang=\"NL\" style=\"font-family: 'Taigi Unicode';\"><br /></span></b></div><div class=\"MsoNormal\"><span style=\"color: blue;\"><b><span lang=\"NL\" style=\"font-family: 'Taigi Unicode';\">Saⁿ-kap</span></b><b><span face=\"新細明體\">讀小說</span></b></span><b><span lang=\"NL\"><o:p></o:p></span></b></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\">黃文宏</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">/</span><span face=\"新細明體\" style=\"font-size: 11pt;\">白色</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">ê</span><span face=\"新細明體\" style=\"font-size: 11pt;\">山嶺</span><span face=\"新細明體\" style=\"font-size: 9pt;\">（一）</span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\">邱偉欣</span><span style=\"font-family: 'Taigi Unicode'; font-size: 15px;\">/</span><span face=\"新細明體\" style=\"font-size: 11pt;\">事變</span><span face=\"新細明體\" style=\"font-size: 9pt;\">（一）</span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\">施俊州</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">/Hibálih</span><span face=\"新細明體\" style=\"font-size: 11pt;\">姑娘</span><span face=\"新細明體\" style=\"font-size: 9pt;\">（四）</span></div><div class=\"MsoNormal\"><b><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></b></div><div class=\"MsoNormal\"><span style=\"color: blue;\"><b><span face=\"新細明體\" style=\"font-size: 11pt;\">逐家來</span></b><b><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">phò-tāu</span></b></span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\"><o:p></o:p></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\">林漢森</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">/</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">T</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">ā</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">m-sám</span><span face=\"新細明體\" style=\"font-size: 11pt;\">會手記</span><span face=\"新細明體\" style=\"font-size: 9pt;\">（第二攤）</span></div><div class=\"MsoNormal\"><b><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></b></div><div class=\"MsoNormal\"><b><span face=\"新細明體\" style=\"color: blue; font-size: 11pt;\">歡喜來演講</span></b><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\"><o:p></o:p></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\">張日東<span lang=\"EN-US\">/</span>風颱天</span></div><div class=\"MsoNormal\"><b><span lang=\"EN-US\" style=\"font-size: 11pt;\"><br /></span></b></div><div class=\"MsoNormal\"><span style=\"color: blue;\"><b><span lang=\"EN-US\" style=\"font-size: 11pt;\">2011</span></b><b><span face=\"新細明體\" style=\"font-size: 11pt;\">阿却賞</span></b></span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\"><o:p></o:p></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\">李淑貞</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">/</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">Suí</span><span face=\"新細明體\" style=\"font-size: 11pt;\">人無</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">suí</span><span face=\"新細明體\" style=\"font-size: 11pt;\">命</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 9pt;\">(</span><span face=\"新細明體\" style=\"font-size: 9pt;\">一</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 9pt;\">)</span></div><div class=\"MsoNormal\"><b><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></b></div><div class=\"MsoNormal\"><b><span face=\"新細明體\" style=\"color: blue; font-size: 11pt;\">光景</span></b><b><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\"><span style=\"color: blue;\">bóng uē</span><o:p></o:p></span></b></div><div class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\"><br /></span></div><div class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">Tan,Uichi/</span><span face=\"新細明體\" style=\"font-size: 11pt;\">來去香港</span><span face=\"新細明體\" style=\"font-size: 9pt;\">（三）－－</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 9pt;\">Tī</span><span face=\"新細明體\" style=\"font-size: 9pt;\">「二樓冊店」讀香港</span></div><div class=\"MsoNormal\"><b><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></b></div><div class=\"MsoNormal\"><b><span face=\"新細明體\" style=\"color: blue; font-size: 11pt;\">台語鋸屑</span></b><b><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\"><o:p></o:p></span></b></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\"><br /></span></div><div class=\"MsoNormal\"><span face=\"新細明體\" style=\"font-size: 11pt;\">潘科元</span><span lang=\"EN-US\" style=\"font-family: 'Taigi Unicode'; font-size: 11pt;\">/</span><span face=\"新細明體\" style=\"font-size: 11pt;\">論台語借音字</span></div>"
