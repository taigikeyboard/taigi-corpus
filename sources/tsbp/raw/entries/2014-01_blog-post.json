    "$t": "穩穩仔蹛 "
  },
  "content": {
    "type": "html",
    "$t": "<span style=\"font-family: Times, Times New Roman, serif;\">洪錦田</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\"><br /></span>\n<span style=\"font-family: Times, Times New Roman, serif;\">6--月火燒埔&nbsp;</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">Sì-kuè顛倒無焦塗</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">家家戶戶電風 冷氣搧規晡</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">風颱kap流塗糜kā我放tiau講</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">伊的確無beh kap我講通和</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\"></span><br />\n<a name='more'></a><span style=\"font-family: Times, Times New Roman, serif;\"><br /></span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">厝兜離潭墘、溪河iáu tsiâⁿ遠</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">離山崙koh-khah夭壽遠</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">流塗糜干干仔強beh來</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">像虎sa̍p tīteh吞食 &nbsp;一樓</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">客廳kap天pông</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">我徙到四樓</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">塗石用跤弓開四樓壁堵</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">kā我淹kah像豬八戒</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\"><br /></span>\n<span style=\"font-family: Times, Times New Roman, serif;\">為怎樣</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">我去問童乩</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">伊講「流塗糜m̄是－</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">m̄是uī山坡地、溪仔流--來-ê &nbsp;是－</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">uī人心上烏暗 &nbsp;上奸詐ê所在來-ê」</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\"><br /></span>\n<span style=\"font-family: Times, Times New Roman, serif;\">原來 &nbsp;聽講</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">是uī惡毒查某ê心肝底</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">夯起來--ê</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">上毒婦人心</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">風風雨雨lóng聽伊ê使派（sái-phài）</span><br />\n<span style=\"font-family: Times, Times New Roman, serif;\">流塗糜mā是伊所致</span>"
  },
