  "title": {
    "type": "text",
    "$t": "阮ê約束"
  },
  "content": {
    "type": "html",
    "$t": "<p><span style=\"font-size: large;\"><span><b>作者：</b></span></span><span style=\"font-size: large;\"><b>孫翊倫</b></span></p><div><div class=\"separator\" style=\"clear: both; text-align: center;\"><br /></div></div><p style=\"text-align: justify;\"><span style=\"font-size: large;\">人是</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">望子成龍　望女成鳳</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">伊是</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">望我健康　望我快樂</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\"><br /></span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">一工24點鐘</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">無暝無日　kap我黏tiâu-tiâu</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\"><br /></span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">艱苦病疼</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">悲哀鬱卒</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">歡頭喜面</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">伊lóng伴我行--過</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\"><br /></span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">伊無kā我放sak</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">無聽伊huah一聲艱苦</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\"><br /></span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">十外冬ê日子</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">一目nih仔</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">Kā我tshiânn kah伊半ló老--ah！</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\"><br /></span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">伊ê白頭毛</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">是年歲ê影跡</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">伊ê跤骨</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">是走tsông ê記錄</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">伊ê皮膚</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">是歲頭ê jiâu痕</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\"><br /></span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">伊自少年就tsiok無閒</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">無閒趁錢　無閒huānn家</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">無閒顧我tsit个bē行--ê</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\"><br /></span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">Bē行m̄是bē-hiáu行</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">是想beh　mā無法度行</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\"><br /></span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">雖bóng bē行</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">M̄-koh　堅強活--落-去khah要緊</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\"><br /></span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">伊　就是我ê阿母</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">伊kap我約束</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\"><br /></span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">後世人</span></p><p style=\"text-align: justify;\"><span style=\"font-size: large;\">換我做伊ê阿母</span></p><div style=\"text-align: justify;\"><br /></div><span></span><span><a name='more'></a></span><div class=\"separator\" style=\"clear: both; text-align: center;\"><br /></div><br /><div class=\"separator\" style=\"clear: both; text-align: center;\"><div class=\"separator\" style=\"clear: both; text-align: center;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEj95FiyQ-jh9W6424TQX5k0yXubdmscxuxub0daTfIQrRe7fzEBl9NdQ6J4lJzUZnEWWoKzHekoHmqYvqMQVDXQHLXMAmJJqlimTrkYyeIhq_H-NOf_TM0sdsXW93jWl0HNZAAMp-eQdnVstmUuu_tknhJGHptvxYo-JEXyiFrw1t2pEzOXNZp86IG_Bx8c/s3036/%E5%8F%B0%E6%96%87%E9%80%9A%E8%A8%8ABONG%E5%A0%B1356%E6%9C%9F_%E9%BB%91%E7%99%BD%E5%85%A7%E9%A0%8148%E9%A0%814.jpg\" imageanchor=\"1\" style=\"margin-left: 1em; margin-right: 1em;\"><img border=\"0\" data-original-height=\"3036\" data-original-width=\"2150\" height=\"640\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEj95FiyQ-jh9W6424TQX5k0yXubdmscxuxub0daTfIQrRe7fzEBl9NdQ6J4lJzUZnEWWoKzHekoHmqYvqMQVDXQHLXMAmJJqlimTrkYyeIhq_H-NOf_TM0sdsXW93jWl0HNZAAMp-eQdnVstmUuu_tknhJGHptvxYo-JEXyiFrw1t2pEzOXNZp86IG_Bx8c/w454-h640/%E5%8F%B0%E6%96%87%E9%80%9A%E8%A8%8ABONG%E5%A0%B1356%E6%9C%9F_%E9%BB%91%E7%99%BD%E5%85%A7%E9%A0%8148%E9%A0%814.jpg\" width=\"454\" /></a></div><br /><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgxtZ2E6m1Z0ojGwLdCNJkKt1XLy25f7UWQpEDTG6WImb_MIzJ9TCv3V0M77_ZDZVdJXqqAcp8UD4vt_6c81mopQxR_rxgp1HyCOrp_h-vWVQE3yexYgL3BKeBV9pD1NlNFLRkgCex5HnQ6jNDb8EJTxmyCW2wDCaQT9U8zEW2ja8RZ8LwRU6sF-jMnBn8W/s1424/356%E5%8F%B0%E6%96%87%E9%80%9A%E8%A8%8ABONG%E5%A0%B1_%E5%B0%81%E9%9D%A2.jpg\" style=\"margin-left: 1em; margin-right: 1em;\"><img border=\"0\" data-original-height=\"1424\" data-original-width=\"1000\" height=\"640\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgxtZ2E6m1Z0ojGwLdCNJkKt1XLy25f7UWQpEDTG6WImb_MIzJ9TCv3V0M77_ZDZVdJXqqAcp8UD4vt_6c81mopQxR_rxgp1HyCOrp_h-vWVQE3yexYgL3BKeBV9pD1NlNFLRkgCex5HnQ6jNDb8EJTxmyCW2wDCaQT9U8zEW2ja8RZ8LwRU6sF-jMnBn8W/w450-h640/356%E5%8F%B0%E6%96%87%E9%80%9A%E8%A8%8ABONG%E5%A0%B1_%E5%B0%81%E9%9D%A2.jpg\" width=\"450\" 