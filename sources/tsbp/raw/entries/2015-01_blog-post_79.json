    "$t": "黃金風鈴花（有聲♪）"
  },
  "content": {
    "type": "html",
    "$t": "<div style=\"text-align: center;\">\n<iframe allowfullscreen=\"\" frameborder=\"0\" height=\"315\" src=\"https://www.youtube.com/embed/zaU6AHxZOzQ?list=PLXGFtP8Nq2rPRttUxu-6cAsoUJjZAB6BQ\" width=\"560\"></iframe><br /></div>\n<div style=\"text-align: center;\">\n台文通訊BONG報八月號（No.269）</div>\n<div>\n<div style=\"text-align: center;\">\n-----------------------------------------------</div>\n<div>\n<div style=\"text-align: center;\">\n</div>\n</div>\n</div>\n▍黃金風鈴花<br />\n作者：蘇晏德<br />\n<br />\n<div class=\"MsoNormal\">\n<span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">平時無</span><span lang=\"EN-US\">tap</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">無</span><span lang=\"EN-US\">sap ê</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">朴子溪</span></div>\n<div class=\"MsoNormal\">\n<span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">Lán人過年後</span> </div>\n<div class=\"MsoNormal\">\n<span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">出現黃黃</span><span lang=\"EN-US\">hiánn-ba̍k ê</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">貴客</span></div>\n<div class=\"MsoNormal\">\n<span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">伊叫做黃金風鈴花</span></div>\n<div class=\"MsoNormal\">\n<span lang=\"EN-US\">Tī</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">朴子溪</span>\n<span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">南爿</span><span lang=\"EN-US\">ê poh</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">岸邊</span></div>\n<div class=\"MsoNormal\">\n<span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">熱情開</span><span lang=\"EN-US\">kah</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">滿sì-kuè</span></div>\n<div class=\"MsoNormal\">\n<br /></div>\n<div class=\"MsoNormal\">\n<span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">朴子溪</span><span lang=\"EN-US\">ê</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">南爿叫</span><span lang=\"EN-US\">Khe-lâm</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">里</span></div>\n<div class=\"MsoNormal\">\n<span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">屬</span><span lang=\"EN-US\">tī</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">太保市治理</span></div>\n<div class=\"MsoNormal\">\n<span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">北爿叫</span><span lang=\"EN-US\">Khe-pak</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">村</span></div>\n<div class=\"MsoNormal\">\n<span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">土地是新港鄉</span><span lang=\"EN-US\">ê</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">治理權</span></div>\n<div class=\"MsoNormal\">\n<span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">在地人講：</span></div>\n<div class=\"MsoNormal\">\n<span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">請你用台語大聲叫</span><span lang=\"EN-US\">Khe-lâm kah Khe-pak</span></div>\n<div class=\"MsoNormal\">\n<span lang=\"EN-US\">M̄-thang</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">用華語叫『溪南』</span><span lang=\"EN-US\">kah</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">『溪北』</span></div>\n<div class=\"MsoNormal\">\n<span lang=\"EN-US\">Nā</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">無</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">外人會誤解</span></div>\n<div class=\"MsoNormal\">\n<span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">阮遮叫「死人」</span><span lang=\"EN-US\">kah</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">「死父」</span></div>\n<div class=\"MsoNormal\">\n<br /></div>\n<div class=\"MsoNormal\">\n<span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">黃金風鈴花</span> <span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">黃黃黃</span></div>\n<div class=\"MsoNormal\">\n<span lang=\"EN-US\">Poh</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">岸邊</span><span lang=\"EN-US\">ê</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">路</span> <span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">長長長</span></div>\n<div class=\"MsoNormal\">\n<span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">一路行</span><span lang=\"EN-US\">kah</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">跤</span> <span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">酸酸酸</span></div>\n<div class=\"MsoNormal\">\n<span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">風鈴花</span> <span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">你</span><span lang=\"EN-US\">ê</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">性命無久長</span></div>\n<div class=\"MsoNormal\">\n<span lang=\"EN-US\">M̄-koh</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">你予朴子溪發光</span></div>\n<div class=\"MsoNormal\">\n<span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">風鈴花</span> <span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">你</span><span lang=\"EN-US\">ê</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">旅途無偌遠</span></div>\n<div class=\"MsoNormal\">\n<span lang=\"EN-US\">M̄-koh</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">你致蔭guán &nbsp;</span><span lang=\"EN-US\">ê</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">家庄</span></div>\n<div class=\"MsoNormal\">\n<br /></div>\n<div class=\"MsoNormal\">\n<span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">今年你</span><span lang=\"EN-US\">nā</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">已經錯</span><span lang=\"EN-US\">--</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-hansi-font-family: &quot;Times New Roman&quot;;\">過</span></div>\n<span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; font-size: 12.0pt; mso-ansi-language: EN-US; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;; mso-bidi-language: AR-SA; mso-fareast-language: ZH-TW; mso-font-kerning: 1.0pt; mso-hansi-font-family: &quot;Times New Roman&quot;;\">明年請你</span><span lang=\"EN-US\" style=\"font-family: &quot;Times New Roman&quot;,&quot;serif&quot;; font-size: 12.0pt; mso-ansi-language: EN-US; mso-bidi-language: AR-SA; mso-fareast-font-family: 新細明體; mso-fareast-language: ZH-TW; mso-font-kerning: 1.0pt;\">liōng</span><span style=\"font-family: &quot;新細明體&quot;,&quot;serif&quot;; font-size: 12.0pt; mso-ansi-language: EN-US; mso-ascii-font-family: &quot;Times New Roman&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;; mso-bidi-language: AR-SA; mso-fareast-language: ZH-TW; mso-font-kerning: 1.0pt; mso-hansi-font-family: &quot;Times New Roman&quot;;\">早來約會</span><br />\n<br />"
  },
